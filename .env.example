# Shoreline Cleaning LLC — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# On Vercel, add the same keys in Project Settings → Environment Variables.

# Public site URL used for canonical links, sitemap, and Open Graph.
# Production: https://www.shorelinecleaning757.com
NEXT_PUBLIC_SITE_URL=https://www.shorelinecleaning757.com

# --- Sanity CMS ---
# Create a free project at https://www.sanity.io/manage
# Project ID is visible on the project page. Dataset is usually "production".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Optional: read token for draft/preview content. Keep server-only (no NEXT_PUBLIC_).
SANITY_API_READ_TOKEN=

# Optional: write token only if you use a seed script. Never expose to the browser.
# SANITY_API_WRITE_TOKEN=

# --- Quote form email (Resend) ---
# Create a free account at https://resend.com
# Verify a sending domain, then create an API key.
# The public site will not send email until both RESEND_API_KEY and QUOTE_TO_EMAIL are set.
# Unconfigured form: visitors see a clear error, never a fake "sent" message.
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=Shoreline Cleaning LLC <quotes@shorelinecleaning757.com>

# --- Optional analytics (disabled until set) ---
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
